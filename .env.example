# Alpha Import Exchange — variables d'environnement
#
# Copier en .env.local et renseigner. Aucune valeur ici : ce fichier est
# versionné, il ne doit contenir que des noms.

# Supabase — base de données et authentification
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — paiements et prélèvements SEPA
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — envoi et réception d'e-mails
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# n8n — automatisations
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Gemini — agent de sourcing
GEMINI_API_KEY=
AGENT_SECRET=

# Mapbox — carte du réseau (facultatif : sans jeton, un encart de repli s'affiche)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Application
NEXT_PUBLIC_APP_URL=

# Autres
OPENAI_API_KEY=
TURNSTILE_SECRET_KEY=
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_TRANSPORT=
